datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PesAccount {
  id               String   @id
  title            String
  platform         String   // "android" | "ios"
  price            Float
  oldPrice         Float?
  currency         String   @default("EGP")
  teamStrength     Int
  coins            Int
  gp               String   @default("1M")
  epicCount        Int
  highlightPlayers String   @default("[]") // JSON string of player names
  loginMethod      String
  isAvailable      Boolean  @default(true)
  featured         Boolean  @default(false)
  badge            String?
  imageUrl         String
  details          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stocks           AccountStock[]

  @@map("pes_accounts")
}

model AccountStock {
  id         String     @id @default(uuid())
  accountId  String
  account    PesAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email      String
  password   String
  codeUrl    String
  createdAt  DateTime   @default(now())

  @@map("account_stocks")
}

model SoldAccount {
  id            String   @id @default(uuid())
  accountId     String
  accountTitle  String
  email         String
  password      String
  codeUrl       String
  price         Float
  buyerPhone    String?
  transactionId String?  @unique
  soldAt        DateTime @default(now())

  @@map("sold_accounts")
}

model SupportMessage {
  id        String   @id @default(uuid())
  phone     String
  sender    String   // "user" | "admin"
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("support_messages")
}

