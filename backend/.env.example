PORT=5050
NODE_ENV=production
CLIENT_URL=http://pes.fouadf9.network
DATABASE_URL="file:./pes_store.db"

# ─── Security Secrets (Use random generated strings in production) ───
JWT_SECRET=generate_a_long_random_jwt_secret_key_here_at_least_32_chars
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=generate_a_random_32_character_encryption_key_here

# ─── Admin Credentials ───
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_admin_password

# ─── Paymob Gateway Credentials ───
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
