PORT=5050
NODE_ENV=production
CLIENT_URL=http://pes.fouadf9.network
DATABASE_URL="file:./pes_store.db"

# â”€â”€â”€ Security Secrets (Use random generated strings in production) â”€â”€â”€
JWT_SECRET=generate_a_long_random_jwt_secret_key_here_at_least_32_chars
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=generate_a_random_32_character_encryption_key_here

# â”€â”€â”€ Admin Credentials â”€â”€â”€
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_admin_password

# â”€â”€â”€ Paymob Gateway Credentials â”€â”€â”€
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

# â”€â”€â”€ Paddle Gateway Credentials â”€â”€â”€
# Sandbox API Key from Paddle Dashboard (Developer Tools -> Authentication)
PADDLE_API_KEY=
# Paddle Environment: 'sandbox' or 'production'
PADDLE_ENVIRONMENT=sandbox
# Client Token for Paddle.js overlay checkout (Developer Tools -> Authentication -> Client-side tokens)
PADDLE_CLIENT_TOKEN=
# Webhook Secret Key (Developer Tools -> Notifications)
PADDLE_WEBHOOK_SECRET_KEY=
# EGP to USD Exchange Rate for automatic conversion (default: 50)
USD_EXCHANGE_RATE=50

